{
  "name": "orchestrai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm build:desktop && pnpm --filter @orchestrai/desktop build:renderer",
    "build:desktop": "node scripts/build.mjs",
    "start": "electron apps/desktop/dist/main.cjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/desktop/renderer/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm build:desktop && vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "install:cubase-script": "node scripts/install-cubase-script.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@julusian/midi": "^3.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "1.4.9",
    "electron": "44.3.0",
    "esbuild": "0.27.0",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "sql.js": "1.14.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "3.2.4"
  }
}
